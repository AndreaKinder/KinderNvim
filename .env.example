# ==============================================================================
# KinderNvim — Environment Configuration Reference Template
# Copy this file to .env or export these variables in your ~/.zshrc / ~/.zshenv
# ==============================================================================

# === IA Local: Minuet AI (Completado en línea y sugerencias) ===
LLAMA_APP_ENDPOINT=http://127.0.0.1:9931/v1/chat/completions
LLAMA_APP_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q8_0
LLAMA_APP_API_KEY=none

# === IA Local: Pi Code Assistant (Terminal interactiva flotante/split) ===
PI_COMMAND=pi
PI_PROVIDER=llama-app
PI_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q8_0

# === Servidor local Apple MLX (Fallback opcional) ===
MLX_SERVER_URL=http://127.0.0.1:8080/v1/models

# === Bóveda de Notas & Obsidian ===
OBSIDIAN_VAULT_PATH=/Volumes/Files/notes
OBSIDIAN_DEFAULT_WORKSPACE=notes
OBSIDIAN_NOTES_SUBDIR=zettelkasten
OBSIDIAN_PROJECTS_FOLDER=projects
OBSIDIAN_DAILY_FOLDER=journal
OBSIDIAN_DAILY_TEMPLATE=plantilla-diaria.md
OBSIDIAN_TEMPLATES_FOLDER=templates
OBSIDIAN_ATTACHMENTS_FOLDER=assets
